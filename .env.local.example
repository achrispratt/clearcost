# Supabase — get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — get this from console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Maps — get this from console.cloud.google.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional. PostHog product analytics — off when the key is unset.
# Get the project key from posthog.com > Project settings.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional. Sentry error tracking — off when no DSN is set.
# NEXT_PUBLIC_SENTRY_DSN covers the browser (and the server if SENTRY_DSN is unset).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build only: source maps upload to Sentry when SENTRY_AUTH_TOKEN is set.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
